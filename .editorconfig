# EditorConfig: https://editorconfig.org (the spec most editors read natively or via a plugin).
# Keeps line endings, indentation and final newlines the same in every repo and editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown, so leave them alone.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
